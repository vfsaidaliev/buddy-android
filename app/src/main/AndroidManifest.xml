<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: the "Buddy is using your phone" chip in the status bar -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Developer mode: open the installer for apps the agent builds (install_apk) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets the setup screen ask Android to stop battery optimization for Buddy -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Notification rules: the agent keeps working (and an approval countdown keeps running) with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Scheduled tasks: on time (the user allows it on Android 14+; without, a few minutes late), and again after a restart -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- set_alarm and set_timer: the Clock app's alarms and timers, without opening it -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- calendar_events: read the phone's calendars, asked for the first time it's used -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- the location tool, asked for the first time it's used (not in the Play build) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Buddy Full: "All files access", the phone's shared storage as /sdcard in Buddy's Linux and for the file tools -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Buddy Full: the phone's data and functions (DeviceTools), asked for in the setup guide or on first use -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- not needed to install (a tablet without a SIM or a camera takes it too) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Needed on Android 11+ to see launchable apps for open_app / list_apps -->
    <queries>
        <!-- Buddy Full: whether Shizuku is installed (shell_privileged) -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- the home app, to fold the bubble panel when Recents or Home opens -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".BuddyApp"
        android:localeConfig="@xml/locales_config"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Buddy as the digital assistant app (long-press power, corner swipe): starts listening, no wake word.
             A task of its own: in Buddy's, the system would bring Buddy's main screen to the front with it. -->
        <activity
            android:name=".AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Share to Buddy": photos, files, links and text from any app, into a new or recent chat -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CheckActivity"
            android:exported="false" />

        <activity
            android:name=".MonitorActivity"
            android:exported="false" />

        <activity
            android:name=".TranscriptActivity"
            android:exported="false" />

        <activity
            android:name=".AppPermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".ApiKeysActivity"
            android:exported="false" />

        <activity
            android:name=".SkillsActivity"
            android:exported="false" />

        <activity
            android:name=".GitHubActivity"
            android:exported="false" />

        <activity
            android:name=".SchedulesActivity"
            android:exported="false" />

        <activity
            android:name=".StepsActivity"
            android:exported="false" />

        <activity
            android:name=".PhoneToolActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".SetupActivity"
            android:exported="false" />

        <activity
            android:name=".WaitingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".RulesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".TerminalActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SignInActivity"
            android:exported="false" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- Buddy Full: Shizuku hands Buddy its binder through this (Shizuku's official API) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name=".FilesProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".HiddenNotice"
            android:exported="false" />

        <receiver
            android:name=".Updates"
            android:exported="false" />

        <!-- Scheduled tasks: their alarms (only Buddy's own) -->
        <receiver
            android:name=".Schedules"
            android:exported="false" />

        <!-- Sets the scheduled tasks' alarms again; from the system, so exported (it only re-reads Buddy's own schedules) -->
        <receiver
            android:name=".Schedules$Boot"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- A scheduled task that needs the screen, with "Wake the phone for this task" on -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="" />

        <service
            android:name=".BuddyService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Notification rules: sees notifications from the apps the user's rules watch (Settings → Notification rules) -->
        <service
            android:name=".NotificationWatcher"
            android:exported="true"
            android:label="@string/rules_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
